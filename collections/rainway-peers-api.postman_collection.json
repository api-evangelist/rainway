  "info": {
    "_postman_id": "ea0c337a-0b60-425a-a51f-eef2a91c12c9",
    "name": "Rainway Hub Peers API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Rainway Hub API is a small RESTful API that provides programmatic access to the active Rainway peers connected to the Rainway Network. It is intended as a building block for multi-peer architectures (e.g. enumerating cloud-hosted applications connected as peers so a user can be presented a list of available applications to connect to). Authentication uses HTTP Basic access authentication with a Rainway API Key Pair (public key as username, secret key as password), generated via the Rainway Hub.\n\nContact Support:\n Name: Rainway",
      "type": "text/plain"
    }
  }
